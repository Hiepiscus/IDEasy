<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25.0.0" xmlns:fx="http://javafx.com/fxml/1" spacing="10.0">
  <padding>
    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
  </padding>
  <children>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
      <Button mnemonicParsing="false" onAction="#goBack" text="%home"/>
    </HBox>
    <ComboBox fx:id="commandletSelector" maxWidth="1.7976931348623157E308" prefWidth="400.0" VBox.vgrow="NEVER"/>
    <TextField fx:id="executionDirectoryField" maxWidth="1.7976931348623157E308" prefWidth="400.0" VBox.vgrow="NEVER" visible="false"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
      <VBox fx:id="formContainer" spacing="5.0"/>
    </ScrollPane>
    <HBox alignment="CENTER_RIGHT">
      <children>
        <Button fx:id="runButton" alignment="BOTTOM_RIGHT" contentDisplay="BOTTOM" mnemonicParsing="false" onAction="#runCommandlet" text="%execute"/>
      </children>
    </HBox>
  </children>
</VBox>
