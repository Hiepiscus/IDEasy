<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<fx:root fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" type="ScrollPane" xmlns="http://javafx.com/javafx/25.0.0"
  xmlns:fx="http://javafx.com/fxml/1">
  <VBox maxWidth="1.7976931348623157E308"
    prefHeight="200.0"
    spacing="12.0">
    <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="%commandlet.label"/>
    <ComboBox fx:id="commandlet"
      maxWidth="1.7976931348623157E308"
      promptText="%commandlet.choose"/>

    <Label text="%commandlet.parameters"/>
    <TextField fx:id="parameters"
      maxWidth="1.7976931348623157E308"
      promptText="%commandlet.parameters_hint"/>

    <Button fx:id="execute" defaultButton="true" text="%commandlet.execute"/>
  </VBox>
</fx:root>
